	putn_mask {0xf}
	putn_digit {0}
	putn_digits {"0123456789ABCDEF"}


	; unsafe print
	public print [
		push a;
		push b;
		push c;
		push d;
		mov d SERIAL;
		mov a 0;
		push a;
		.loop [
			# pop the index
				pop a;
				#or b a a ; copy a to b
			# get the char
				#mov c [string]
				popi c 4;
				add b a c;
				ld b b;
			# print the char
				str d b;
			# increment the index and push it back
				mov c 1;
				add a a c;
				push a;
			# loop back if not NULL
				#zr b b;
				#xor b b 1;
				mov a (.loop);
				jnz a b;
		]
		label .exit: 
		pop d; # pop index
		pop d; # pop address
		pop d;
		pop c;
		pop b;
		pop a;
		ret;
	]
]
