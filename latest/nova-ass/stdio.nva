namespace stdio [
	define SERIAL 0x1000

	public putcf [
		push a;
		#push b;
		#push c
		popi a 1;
		str SERIAL a;
		#pop c
		#pop b;
		pop a;
		ret;
	]

	public macro putc ch [
		push a;
		push b;
		mov a @ch;
		mov b SERIAL;
		str b a;
		pop b;
		pop a;
	]

